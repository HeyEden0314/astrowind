---
import { Icon } from 'astro-icon/components';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import { SITE } from 'astrowind:config';
import { getPermalink, getHomePermalink, getAsset, trimSlash } from '~/utils/permalinks';

const navLinks = [
  { text: '情报', href: getPermalink('/') },
  { text: '来源', href: getPermalink('/sources') },
  { text: '关于', href: getPermalink('/about') },
];

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const isActive = (href: string) => `/${trimSlash(href)}` === currentPath;
const siteInitial = SITE?.name?.charAt(0) ?? '情';
---

<header
  class="sticky top-0 z-50 border-b border-gray-100 bg-white/80 backdrop-blur-md dark:border-gray-800 dark:bg-gray-950/80"
>
  <div class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6">
    <a href={getHomePermalink()} class="flex items-center gap-2.5">
      <div
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-blue text-lg font-bold text-white shadow-sm"
      >
        {siteInitial}
      </div>
      <span class="text-xl font-bold tracking-tight text-gray-900 dark:text-white">{SITE?.name}</span>
    </a>

    <nav
      class="hidden items-center gap-6 text-sm font-medium text-gray-600 md:flex dark:text-gray-400"
      aria-label="主导航"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'transition-colors hover:text-gray-900 dark:hover:text-white',
              { 'text-brand-blue dark:text-brand-blue': isActive(link.href) },
            ]}
          >
            {link.text}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <ToggleTheme iconClass="w-5 h-5 text-gray-600 dark:text-gray-400" />
      <a
        href={getAsset('/rss.xml')}
        class="rounded-full p-2 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="RSS 订阅"
      >
        <Icon name="tabler:rss" class="h-5 w-5" />
      </a>
    </div>
  </div>
</header>
