---
import { formatChineseDate } from '~/utils/intelligence';
import type { IntelligenceArticle } from '~/types/intelligence';

export interface Props {
  article: IntelligenceArticle;
}

const { article } = Astro.props;
---

<article
  class="group rounded-xl border border-gray-200/80 bg-white p-5 shadow-sm transition hover:border-primary/30 hover:shadow-md dark:border-gray-700 dark:bg-slate-900"
>
  <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-muted">
    <time datetime={article.published_at}>{formatChineseDate(article.published_at)}</time>
    <span aria-hidden="true">·</span>
    <span class="rounded-full bg-primary/10 px-2.5 py-0.5 font-medium text-primary dark:bg-primary/20">
      {article.source_name}
    </span>
  </div>

  <h2 class="text-xl font-bold leading-snug tracking-tight text-gray-900 dark:text-white">
    <a
      href={article.original_url}
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      {article.title_zh}
    </a>
  </h2>

  <p class="mt-1 text-sm text-muted italic" lang="en">
    {article.original_title}
  </p>

  {
    article.excerpt_zh && (
      <p class="mt-3 line-clamp-3 text-base leading-relaxed text-gray-700 dark:text-gray-300">{article.excerpt_zh}</p>
    )
  }

  <div class="mt-4">
    <a
      href={article.original_url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
    >
      阅读原文
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
