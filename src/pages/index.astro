---
import IntelligenceLayout from '~/layouts/IntelligenceLayout.astro';
import SiteHero from '~/components/intelligence/SiteHero.astro';
import SourceFilter from '~/components/intelligence/SourceFilter.astro';
import ArticleFeed from '~/components/intelligence/ArticleFeed.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import { getIntelligenceArticles } from '~/utils/intelligence';
import favIconSvg from '~/assets/favicons/favicon.svg';

const articles = getIntelligenceArticles();

const metadata = {
  title: '最新 AI 情报',
  description: METADATA?.description,
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<IntelligenceLayout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <SiteHero />
  <SourceFilter />

  <section class="container mx-auto px-4 sm:px-6">
    <ArticleFeed articles={articles} />
  </section>
</IntelligenceLayout>
