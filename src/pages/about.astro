---
import IntelligenceLayout from '~/layouts/IntelligenceLayout.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: '关于本站',
  description: '了解 AI 中文情报站如何聚合与翻译官方 AI 博客。',
};
---

<IntelligenceLayout metadata={metadata}>
  <section class="container mx-auto max-w-3xl px-4 py-12 sm:px-6 md:py-16">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-white">关于 {SITE?.name}</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">官方 RSS 聚合 · Workers AI 翻译 · Cloudflare 免费部署</p>
    </header>

    <div class="prose prose-lg max-w-none text-gray-700 dark:prose-invert dark:text-gray-300">
      <p>
        本站每日从主流 AI 公司与工具的<strong>官方 RSS/Atom 源</strong>抓取最新文章，使用
        <strong>Cloudflare Workers AI</strong
        >（免费层）将标题与摘要翻译为简体中文，并在首页展示中文标题、摘要与原文链接。
      </p>
      <h2>我们做什么</h2>
      <ul>
        <li>优先使用 RSS/Atom，避免不稳定的 HTML 抓取</li>
        <li>保留英文原标题与 canonical 原文 URL</li>
        <li>通过 Cron 定时任务每日更新情报库</li>
        <li>静态站点由 Cloudflare Pages 托管，访问快速、成本低</li>
      </ul>
      <h2>我们不做什么</h2>
      <ul>
        <li>不托管全文内容 — 请通过原文链接访问官方页面</li>
        <li>不使用付费翻译 API</li>
        <li>不代表任何被收录公司的官方立场</li>
      </ul>
      <p>
        <a href="/sources" class="font-medium text-brand-blue hover:underline">查看完整信息来源列表 →</a>
      </p>
    </div>
  </section>
</IntelligenceLayout>
