---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: '关于本站',
  description: '了解 AI 中文情报站如何聚合与翻译官方 AI 博客。',
};
---

<Layout metadata={metadata}>
  <section class="bg-page">
    <div class="prose prose-lg mx-auto max-w-3xl px-4 py-12 dark:prose-invert md:px-6">
      <h1>关于 {SITE?.name}</h1>
      <p>
        本站每日从主流 AI 公司与工具的<strong>官方 RSS/Atom 源</strong>抓取最新文章，使用
        <strong>Cloudflare Workers AI</strong
        >（免费层）将标题与摘要翻译为简体中文，并在首页展示中文标题、摘要与原文链接。
      </p>
      <h2>我们做什么</h2>
      <ul>
        <li>优先使用 RSS/Atom，避免不稳定的 HTML 抓取</li>
        <li>保留英文原标题与 canonical 原文 URL</li>
        <li>通过 Cron 定时任务每日更新情报库</li>
        <li>静态站点由 Cloudflare Pages 托管，访问快速、成本低</li>
      </ul>
      <h2>我们不做什么</h2>
      <ul>
        <li>不托管全文内容 — 请通过「阅读原文」访问官方页面</li>
        <li>不使用付费翻译 API</li>
        <li>不代表任何被收录公司的官方立场</li>
      </ul>
      <h2>技术栈</h2>
      <p>
        前端：Astro v7 + Tailwind CSS v4 · 数据：Cloudflare D1 · 抓取与翻译：Cloudflare Workers + Workers AI ·
        部署：Cloudflare Pages（免费套餐）
      </p>
      <p>
        <a href="/sources">查看完整信息来源列表 →</a>
      </p>
    </div>
  </section>
</Layout>
